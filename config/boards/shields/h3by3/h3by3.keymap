/*
 * h3by3 - 3x3 Handwired Macropad Keymap
 *
 * Default layer (layer 0) : number keys 1-9
 *   1  2  3
 *   4  5  6
 *   7  8  9
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
                &kp N1  &kp N2  &kp N3
                &kp N4  &kp N5  &kp N6
                &kp N7  &kp N8  &kp N9
            >;
        };
    };
};
